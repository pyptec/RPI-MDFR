CLIENT_ID   = pyp_RPI-MDFR_PRUEBA
ENDPOINT    = a6iaynv7vyssn-ats.iot.us-east-1.amazonaws.com #a2fmzntuuij9yf-ats.iot.us-east-1.amazonaws.com
ROOT_CA     = /home/pi/.scr/cert/RootCA1.pem
PRIVATE_KEY = /home/pi/.scr/cert/private.pem.key
CERTIFICATE = /home/pi/.scr/cert/certificate.pem.crt
TOPIC =     pyp/events # sensor/data
TUTOPIC =   tunel/ssh
PORT        = 8883

TIMERCHEQUEOTEMPERATURA=60
TIMERCOLAEVENTOS=60
TIMERMEDICION=600
TIMERPING=120
TIMECHECKUSBETHERNET=600
TIMECHECK_USB_ETHERNET_TIME=6
TIMER_MDFR = 60


#sensor de Co2
CFG_CT01CO2=/home/pi/.scr/.scr/RPI-MDFR/device/ct01co2.yml
#sensor de humedad y temperatura
CFG_THT03R=/home/pi/.scr/.scr/RPI-MDFR/device/tht03r.yml
#sensor de puerto abierta o cerrada
CFG_DOOR=/home/pi/.scr/.scr/RPI-MDFR/device/door.yml
#variables del sistema
CFG_SISTEMA=/home/pi/.scr/.scr/RPI-MDFR/device/sistema.yml
#sensor rtu 
CFG_PT21A01=/home/pi/.scr/.scr/RPI-MDFR/device/PT21A01.yml
#conexion a AWS IoT
CFG_PYP_CONNECT=/home/pi/.scr/.scr/RPI-MDFR/device/pyp_Conect.yml
#HVAC Samsung
CFG_SAMSUNG=/home/pi/.scr/.scr/RPI-MDFR/device/Samsung-HVAC.yml
#relay
CFG_RELAY=/home/pi/.scr/.scr/RPI-MDFR/device/relayDioustou-4.yml

CFG_CT01CO2_SECTION=ct01co2_sensor
CFG_THT03R_SECTION=tht03r_sensor
CFG_PT21A01_SECTION=pt21a01_sensor
CFG_SISTEMA_SECTION=variables_del_sistema
CFG_DOOR_SECTION=door_sensor
CFG_PYP_CONNECT_SECTION=pyp_connect
CFG_SAMSUNG_SECTION=samsung_mim_b19n
CFG_RELAY_SECTION=relayDioustou_4r


EVENT_QUEUE_FILE=/home/pi/.scr/eventos/eventos.txt
RELAY_YAML = '/home/pi/.scr/.scr/RPI-MDFR/device/relayDioustou-4.yml'